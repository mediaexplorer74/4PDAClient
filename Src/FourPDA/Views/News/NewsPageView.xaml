                           TextWrapping="Wrap" HorizontalAlignment="Left" 
                            Foreground="{StaticResource PhoneAccentBrush}" Text="{Binding Title}" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding Body}" />
                        <TextBlock Foreground="{StaticResource PhoneSubtleBrush}"  
                              Text="{Binding Timestamp}" />
                    </StackPanel>
                </DataTemplate>
            </tp:RadDataBoundListBox.ItemTemplate>
            <tp:RadDataBoundListBox.ItemAddedAnimation>
                <telerik:RadFadeAnimation/>
            </tp:RadDataBoundListBox.ItemAddedAnimation>

        </tp:RadDataBoundListBox-->

            <!--
            behaviors:ListBoxBehavior.DisableSelection="True"
            Style="{StaticResource ListBoxStyle}"
            -->
        <!--ListBox ItemsSource="{Binding NewsItems}"
                Margin="24 0 0 0" 
         >
            <ListBox.ItemTemplate>
        <DataTemplate>
                   // telerik:InteractionEffectManager.ApplyInteractionExplicitly="True"
                    <telerik:RadContentControl
                        micro:Message.Attach="[Event Tap] = [Action OpenNewsDetails($dataContext)]"
                        >

                        // micro:Message.Attach="[Event Tap] = [Action OpenNewsDetails($dataContext)]"
                        <StackPanel VerticalAlignment="Top"
                                Background="DarkCyan"
                                Margin="0 0 24 18"
                                
                         >
                            <TextBlock TextDecorations="Underline" FontSize="24"
                                   TextWrapping="Wrap" HorizontalAlignment="Left" 
                                   Foreground="{StaticResource SystemControlForegroundAccentBrush}" 
                                   Text="{Binding Title}" />
                            
                            <TextBlock TextWrapping="Wrap" Text="{Binding Body}" />
                            
                            <TextBlock Foreground="{StaticResource CheckBoxPressedForegroundThemeBrush}" 
                                   Text="{Binding Timestamp}" />
                        </StackPanel>
                        </telerik:RadContentControl>
                    </DataTemplate>
            </ListBox.ItemTemplate>
                
            <ListBox.ItemAddedAnimation>
                <telerik:RadFadeAnimation/>
            </ListBox.ItemAddedAnimation>

        </ListBox-->
        </ListView>
    </Grid>


    <!-- Bottom app bar -->
    <Page.BottomAppBar>
        <CommandBar>
            <CommandBar.PrimaryCommands>
              <AppBarButton
                x:Name="Back"
                x:Uid="Back"
                Click="Back_Click"
                Icon="Back"
                Label="Back"/>

                <AppBarButton
                x:Name="Forward"
                x:Uid="Forward"
                Click="Forward_Click"
                Icon="Forward"
                Label="Forward"/>

                <AppBarButton
                  x:Name="Home"
                  x:Uid="Home"
                  Click="Home_Click"
                  Icon="Home"
                  Label="Home"/>
                
                <AppBarButton
                x:Name="Forum"
                x:Uid="Forum"
                Click="Forum_Click"
                Icon="NewWindow"
                Label="Forum"/>

               
            </CommandBar.PrimaryCommands>


            <CommandBar.SecondaryCommands>
                <AppBarButton
                     x:Name="Refresh"
                     x:Uid="Refresh"
                     Click="Refresh_Click"
                     Icon="Refresh"
                     Label="Refresh"/>

                <AppBarButton
                 x:Name="Settings"
                 x:Uid="Settings"
                 Click="Settings_Click"
                 Icon="Setting"
                 Label="Settings"/>
         
                <AppBarToggleButton
                x:Name="UiThemeToggle"
                x:Uid="UiThemeToggle"
                Click="UiThemeToggle_Click"
                Icon="Clock"
                Label="Dark theme"/>
                
                <AppBarToggleButton
                x:Name="ForumModeToggle"
                x:Uid="ForumModeToggle"
                Click="ForumModeToggle_Click"
                Icon="Document"
                Label="Forum mode"/>

                <AppBarButton
                 x:Name="AboutMe"
                 x:Uid="AboutMe"
                 Click="AboutApp_Click"
                 Icon="Contact"
                 Label="About"/>
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>

</Page>
    
