            <ListView ItemsSource="{Binding NewsItems}"
                      Margin="24 0 0 0" 
                      IsItemClickEnabled="True"
                      SelectionMode="None"
                      micro:Message.Attach="[Event ItemClick] = [Action OpenNewsDetails($clickeditem)]"
                             >
            <ListView.ItemTemplate>
                <DataTemplate>

                    <!--micro:Message.Attach="[Event Tap] = [Action OpenNewsDetails($dataContext)]"
                    Text="{Binding Title}" 
                    -->
               <StackPanel VerticalAlignment="Top"
                    Margin="0 0 24 18" >
                        
                          <TextBlock 
                            TextDecorations="Underline" FontSize="24" 
                            TextWrapping="Wrap"  HorizontalAlignment="Left" 
                            Foreground="{StaticResource SystemColorControlAccentBrush}" 
                            Text="{Binding Title}"  
                            />
                          <TextBlock TextWrapping="Wrap" Text="{Binding Body}" />
                        <TextBlock Foreground="{StaticResource AppBarBorderThemeBrush}"  
                  Text="{Binding Timestamp}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
            <!--tp:RadCycleHubTile.ItemAddedAnimation>
                <telerik:RadFadeAnimation/>
            </tp:RadCycleHubTile.ItemAddedAnimation-->



